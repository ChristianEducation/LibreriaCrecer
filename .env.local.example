DATABASE_URL=postgresql://usuario:password@host:puerto/postgres
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service Role Key de Supabase — SOLO server-side, nunca NEXT_PUBLIC_.
# Requerida para subir/leer el bucket privado "chilexpress-labels" (etiquetas
# con datos personales del destinatario) y generar sus signed URLs.
SUPABASE_SERVICE_ROLE_KEY=

GETNET_LOGIN=tu-getnet-login

GETNET_SECRET_KEY=tu-getnet-secret-key

GETNET_ENDPOINT=https://checkout.test.getnet.cl

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Habilitar solo cuando el inventario este confirmado.
STORE_PURCHASES_ENABLED=false

# Chilexpress — server-side exclusivamente, nunca NEXT_PUBLIC_.
# Ambiente de pruebas (self-service developers.wschilexpress.com):
#   endpoints con host testservices.wschilexpress.com
# Ambiente productivo:
#   endpoints con host services.wschilexpress.com (sin "test")
CHILEXPRESS_COVERAGE_API_KEY=
CHILEXPRESS_RATING_API_KEY=
CHILEXPRESS_SHIPMENT_API_KEY=
CHILEXPRESS_TCC=
CHILEXPRESS_SENDER_RUT=
# Confirmado por codigo: BUSINESS_DEFAULTS en
# src/integrations/shipping/chilexpress/config.ts y BRAND.address
# (Arturo Prat 470, Antofagasta) en src/shared/config/brand.ts.
CHILEXPRESS_ORIGIN_REGION_CODE=R2
CHILEXPRESS_ORIGIN_COMMUNE=Antofagasta
# NO completar todavia: el codigo "ANTO" que se uso en QA no esta verificado
# contra el dataset de coberturas de PRODUCCION. Si se deja vacio, el sistema
# lo resuelve solo llamando a Coberturas en cada cotizacion (mas lento pero
# seguro). Completar recien despues de confirmar el codigo real en la Fase 6
# (prueba de Coberturas PROD).
CHILEXPRESS_ORIGIN_COVERAGE_CODE=
CHILEXPRESS_COVERAGE_ENDPOINT=https://services.wschilexpress.com/georeference/api/v1.0
CHILEXPRESS_RATING_ENDPOINT=https://services.wschilexpress.com/rating/api/v1.0
CHILEXPRESS_SHIPMENT_ENDPOINT=https://services.wschilexpress.com/transport-orders/api/v1.0





ADMIN_JWT_SECRET=una-clave-secreta-larga-y-segura




